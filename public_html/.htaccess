# ===================================================================
# public_html/.htaccess — Document Root
# Routing + Security Headers + Blocchi
# ===================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Path traversal block (sia query string che path URI)
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\) [NC,OR]
    RewriteCond %{REQUEST_URI} (\.\./|\.\.\\) [NC]
    RewriteRule ^ - [F,L]

    # Blocco path CMS/exploit comuni
    RewriteRule ^(wp-login|xmlrpc|wp-admin|phpmyadmin|shell|eval|cmd)\.php$ - [F,L]
    RewriteRule ^\.(env|git|ht|svn|DS_Store) - [F,L]

    # Blocco metodi HTTP non necessari
    RewriteCond %{REQUEST_METHOD} !^(GET|POST|HEAD|OPTIONS)$
    RewriteRule ^ - [F,L]

    # File e directory reali serviti direttamente (assets, ecc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tutto il resto va a index.php (front controller)
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# ===================================================================
# Security Headers
# ===================================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # CSP stretta: niente unsafe-inline (scelta consapevole per evitare debito tecnico)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

    # Rimuove fingerprinting del server
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# ===================================================================
# Blocca file sensibili anche se finissero per errore in public_html
# ===================================================================
<FilesMatch "(\.env|\.log$|\.bak$|\.sql$|\.sqlite$|\.ini$|composer\.(json|lock))">
    Require all denied
</FilesMatch>

# ===================================================================
# Disabilita listing directory
# ===================================================================
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# ===================================================================
# Compressione (solo asset statici — niente HTML/JSON per evitare leak token)
# ===================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
</IfModule>

# ===================================================================
# Caching asset statici
# ===================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "now"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

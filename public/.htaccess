# =============================================================
# public/.htaccess — Document Root (post-rename da public_html)
# =============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\) [NC,OR]
    RewriteCond %{REQUEST_URI} (\.\./|\.\.\\) [NC]
    RewriteRule ^ - [F,L]

    RewriteRule ^(wp-login|xmlrpc|wp-admin|phpmyadmin|shell|eval|cmd)\.php$ - [F,L]
    RewriteRule ^\.(env|git|ht|svn|DS_Store) - [F,L]

    RewriteCond %{REQUEST_METHOD} !^(GET|POST|HEAD|OPTIONS)$
    RewriteRule ^ - [F,L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L,QSA]
</IfModule>

# =============================================================
# Security Headers
# =============================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # -------------------------------------------------------------
    # Content-Security-Policy
    # Permette Bootstrap/Chart.js (jsdelivr, cdnjs), Google Fonts,
    # stili inline (necessari a Bootstrap) e same-origin.
    #
    # HARDENING PRODUZIONE:
    #   1) Rimuovere 'unsafe-inline' da script-src e usare nonce:
    #        Header set Content-Security-Policy "... script-src 'self' 'nonce-XYZ' ..."
    #      Generare il nonce in bootstrap.php: bin2hex(random_bytes(16))
    #      e inserirlo in ogni <script nonce="...">.
    #   2) Rimuovere 'unsafe-inline' da style-src e migrare gli style=""
    #      inline in classi CSS, oppure usare hash SHA-256 per i blocchi
    #      residui: 'sha256-BASE64HASH'.
    #   3) Limitare le CDN: sostituire 'jsdelivr'/'cdnjs' con gli host
    #      effettivamente in uso o, meglio, self-host con SRI.
    # -------------------------------------------------------------
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"

    Header unset X-Powered-By
    Header unset Server
</IfModule>

# =============================================================
# File sensibili
# =============================================================
<FilesMatch "(\.env|\.log$|\.bak$|\.sql$|\.sqlite$|\.ini$|composer\.(json|lock))">
    Require all denied
</FilesMatch>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "now"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
